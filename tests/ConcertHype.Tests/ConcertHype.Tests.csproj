<Project Sdk="Microsoft.NET.Sdk">
	<ItemGroup>
		<!--Compile the mod's source in directly, so building tests never deploys the mod-->
		<Compile Include="..\..\mods\Concert Hype\**\*.cs" Exclude="..\..\mods\Concert Hype\obj\**;..\..\mods\Concert Hype\bin\**" LinkBase="Mod" />
		<Compile Include="..\..\shared\UiCopies\UiCopies.cs" LinkBase="Mod" />
		<!--Unofficial Patch also changes the concert revenue estimate; the estimate tests run with both mods-->
		<Compile Include="..\..\mods\Unofficial Patch\**\*.cs" Exclude="..\..\mods\Unofficial Patch\obj\**;..\..\mods\Unofficial Patch\bin\**" LinkBase="UnofficialPatch" />
	</ItemGroup>

	<ItemGroup>
		<!--Copy these from the game's IM_Data\Managed folder. The lineup panel uses CanvasGroup, its drags the mouse
		    button, its icons load PNGs, and the bench's group dropdown has an Animator-->
		<Reference Include="UnityEngine.AnimationModule">
			<HintPath>$(dllDir)\UnityEngine.AnimationModule.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.UIModule">
			<HintPath>$(dllDir)\UnityEngine.UIModule.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.InputLegacyModule">
			<HintPath>$(dllDir)\UnityEngine.InputLegacyModule.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.ImageConversionModule">
			<HintPath>$(dllDir)\UnityEngine.ImageConversionModule.dll</HintPath>
		</Reference>
	</ItemGroup>
</Project>
