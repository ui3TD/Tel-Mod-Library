<Project Sdk="Microsoft.NET.Sdk">
	<ItemGroup>
		<!--Compile the mod's source in directly, so building tests never deploys the mod-->
		<Compile Include="..\..\mods\MBTI Personalities\**\*.cs" Exclude="..\..\mods\MBTI Personalities\obj\**;..\..\mods\MBTI Personalities\bin\**" LinkBase="Mod" />
	</ItemGroup>

	<ItemGroup>
		<!--Copy these from the game's IM_Data\Managed folder-->
		<!--For Canvas (profile and audition card patches)-->
		<Reference Include="UnityEngine.UIModule">
			<HintPath>$(dllDir)\UnityEngine.UIModule.dll</HintPath>
		</Reference>
		<!--Type-forwarding facade; Harmony needs it to compile patched methods that reference it-->
		<Reference Include="UnityEngine">
			<HintPath>$(dllDir)\UnityEngine.dll</HintPath>
		</Reference>
	</ItemGroup>
</Project>
