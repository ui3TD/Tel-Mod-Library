<Project Sdk="Microsoft.NET.Sdk">
	<!--
	Run these tests in Debug: dotnet test -c Debug.
	In Release every test fails during setup (Seams.Install: "Theaters_CompleteDay.Postfix: ECall methods must
	be packaged into a system module"). This isn't caused by a test or the mod: it also happens on commits
	where the suite passes in Debug (checked 2026-10-08).
	-->
	<ItemGroup>
		<!--Compile the mod's source in directly, so building tests never deploys the mod-->
		<Compile Include="..\..\mods\Unofficial Patch\**\*.cs" Exclude="..\..\mods\Unofficial Patch\obj\**;..\..\mods\Unofficial Patch\bin\**" LinkBase="Mod" />
	</ItemGroup>

	<ItemGroup>
		<!--Copy these from the game's IM_Data\Managed folder-->
		<!--mainScript's static fields (notification colours) need it to initialise-->
		<Reference Include="UnityEngine.UnityWebRequestModule">
			<HintPath>$(dllDir)\UnityEngine.UnityWebRequestModule.dll</HintPath>
		</Reference>
		<!--For Canvas (the fan pie and tour popup patches)-->
		<Reference Include="UnityEngine.UIModule">
			<HintPath>$(dllDir)\UnityEngine.UIModule.dll</HintPath>
		</Reference>
		<!--Type-forwarding facade; Harmony needs it to compile patched methods that reference it-->
		<Reference Include="UnityEngine">
			<HintPath>$(dllDir)\UnityEngine.dll</HintPath>
		</Reference>
	</ItemGroup>
</Project>
