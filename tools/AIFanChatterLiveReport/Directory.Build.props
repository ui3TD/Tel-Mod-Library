<Project>
	<!--
	Replaces the root Directory.Build.props, so building this tool never deploys anything to the game's
	Mods folder. The game assemblies are the ones the unit tests use.
	-->
	<PropertyGroup>
		<!--Game DLLs: the folder in the IDOL_MANAGER_GAME_DLLS environment variable when set, else IM-Modding\dll beside this repo.-->
		<dllDir Condition="'$(IDOL_MANAGER_GAME_DLLS)' != ''">$(IDOL_MANAGER_GAME_DLLS)</dllDir>
		<dllDir Condition="'$(dllDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\dll</dllDir>
		<LangVersion>latest</LangVersion>
		<TargetFramework>net472</TargetFramework>
		<!--Mono-built game assemblies; run as x64 like the game-->
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>

	<ItemGroup>
		<!--Game assemblies are copied next to the tool so game types can load. Never commit them.-->
		<Reference Include="Assembly-CSharp" Publicize="true">
			<HintPath>$(dllDir)\Assembly-CSharp.dll</HintPath>
		</Reference>
		<Reference Include="Assembly-CSharp-firstpass">
			<HintPath>$(dllDir)\Assembly-CSharp-firstpass.dll</HintPath>
		</Reference>
		<Reference Include="Harmony">
			<HintPath>$(dllDir)\0Harmony.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.UI">
			<HintPath>$(dllDir)\UnityEngine.UI.dll</HintPath>
		</Reference>
		<Reference Include="Unity.TextMeshPro">
			<HintPath>$(dllDir)\Unity.TextMeshPro.dll</HintPath>
		</Reference>
		<Reference Include="DOTween">
			<HintPath>$(dllDir)\DOTween.dll</HintPath>
		</Reference>
		<!--Runnable Unity code (Mathf etc.), from the game's UnstrippedLibs folder-->
		<Reference Include="UnityEngine.CoreModule">
			<HintPath>$(dllDir)\UnityEngine.CoreModule.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.SharedInternalsModule">
			<HintPath>$(dllDir)\UnityEngine.SharedInternalsModule.dll</HintPath>
		</Reference>

		<!--The mod names game members with nameof, so it compiles against a public copy of Assembly-CSharp-->
		<PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" ExcludeAssets="contentFiles" />
	</ItemGroup>

	<!--Compile against the public copy only, and run against the game's real Assembly-CSharp-->
	<Target Name="PublicizeNamesOnly" AfterTargets="Publicize">
		<ItemGroup>
			<Compile Remove="$(GeneratedIgnoresAccessChecksToFile)" />
		</ItemGroup>
		<PropertyGroup>
			<AllowUnsafeBlocks>false</AllowUnsafeBlocks>
		</PropertyGroup>
	</Target>
	<Target Name="CopyRealGameAssembly" AfterTargets="Build">
		<Copy SourceFiles="$(dllDir)\Assembly-CSharp.dll" DestinationFolder="$(OutDir)" />
	</Target>
</Project>
